#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$root/.local/bin:$PATH"
command="${1:-help}"
case "$command" in
  install)
    shift
    exec bash "$root/scripts/install.sh" "$@"
    ;;
  up)
    shift
    if [[ $# -gt 0 ]]; then
      echo "up 不接受参数。" >&2
      exit 2
    fi
    if [[ ! -x "$root/platform/.venv/bin/python" || ! -x "$root/.local/engine-src/.venv/bin/python" || ! -f "$root/web/.next/BUILD_ID" ]] ||
       ! "$root/platform/.venv/bin/python" "$root/scripts/local_runtime.py" check-config >/dev/null 2>&1 ||
       ! "$root/platform/.venv/bin/python" "$root/scripts/local_runtime.py" check-database >/dev/null 2>&1; then
      bash "$root/scripts/install.sh"
    fi
    exec "$root/platform/.venv/bin/python" "$root/scripts/local_runtime.py" up
    ;;
  container)
    shift
    exec bash "$root/scripts/compose_local.sh" "$@"
    ;;
  start|stop|status|doctor|admin)
    if [[ ! -x "$root/platform/.venv/bin/python" ]]; then
      echo "SeeAlpha 尚未安装，请先执行 ./seealpha install" >&2
      exit 2
    fi
    exec "$root/platform/.venv/bin/python" "$root/scripts/local_runtime.py" "$@"
    ;;
  help|-h|--help)
    cat <<'HELP'
SeeAlpha 本机管理（仅 macOS / Linux，本机 HTTP，不用于生产）
  ./seealpha up                      首次自动安装并启动，后续直接启动
  ./seealpha install                 自动准备本机 uv/Node、固定 Engine、Platform、Web 和新 SQLite
  ./seealpha install --no-bootstrap  仅检查已有工具，不下载安装本地工具
  ./seealpha admin create [用户名]  交互创建账号（默认 admin）
  ./seealpha admin reset [用户名]   交互重置密码
  ./seealpha start                   启动本机 Engine、API、Web
  ./seealpha container up vX.Y.Z     通过已发布 Docker 镜像安装/运行本地版
  ./seealpha container status        查看容器部署状态
  ./seealpha status                  查看进程与健康状态
  ./seealpha doctor                  检查依赖、配置和本机服务
  ./seealpha stop                    顺序停止本启动器管理的进程
HELP
    ;;
  *)
    echo "未知命令：$command（运行 ./seealpha help 查看用法）" >&2
    exit 2
    ;;
esac
