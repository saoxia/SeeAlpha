{
  "name": "alpha-arena-trading-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "start:lan": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --ignore-pattern .next",
    "generate:api-types": "../.venv/bin/python scripts/generate_api_types.py",
    "test:frontend": "node --experimental-strip-types --test app/features/live/*.test.ts app/features/data-management/*.test.ts app/features/research/*.test.ts app/features/trade/*.test.ts app/features/identity/*.test.ts"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
